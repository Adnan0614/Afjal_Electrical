# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=afjal_electrical

# Comma-separated frontend origins. Example:
CORS_ORIGINS=https://your-domain.vercel.app
APP_URL=https://your-domain.vercel.app

# Owner authentication — generate unique production values
OWNER_PIN=change-this-to-a-strong-secret
OWNER_SESSION_SECRET=generate-a-long-random-secret

# Optional services
EMERGENT_LLM_KEY=
